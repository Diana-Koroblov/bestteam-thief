# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Appendix E rules #39, #40 — leaking any of these fails the project.

# --- Gmail API (Appendix A). Send-only scope. Rule #30. -------------------
GMAIL_CREDENTIALS_PATH=./secrets/credentials.json
GMAIL_TOKEN_PATH=./secrets/token.json

# --- LLM provider ----------------------------------------------------------
# Selects the trash-talk provider for THIS machine. Overrides
# [trash_talk] provider in config/<role>/game.toml, which is committed as
# `template` so a fresh clone always runs with zero tokens.
#   template   book default, zero tokens, no network - safe fallback anywhere
#   ollama     local model, zero API tokens - preferred for graded matches, but
#              ONLY while it is actually up: if localhost:11434 does not answer,
#              every turn pays the provider timeout before falling back anyway.
#   groq       our extra provider (ADR-003), hosted and METERED
#   claude_api cloud Haiku, real token cost against the 200k series budget
# Movement is never decided by a model (Ch. 6); this affects text only.
P2P_LLM_PROVIDER=template
GROQ_API_KEY=gsk_replace_me
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=sk-ant-replace-me-optional

# --- Tunnelling ------------------------------------------------------------
# The provider is chosen in config/<role>/game.toml [network] tunnel_provider.
# ngrok is primary; localtonet is the documented fallback and needs a token
# only on the day it is actually switched on.
NGROK_AUTHTOKEN=replace_me
# Your reserved static domain, e.g. something.ngrok-free.dev. Reserve one free at
# https://dashboard.ngrok.com/domains/new. A domain is bound to ONE ngrok account,
# so it belongs here and not in committed config: a domain reserved on someone
# else's account fails with ERR_NGROK_320 and no match can be played publicly.
# Leave empty to let the agent assign a random URL each run, which also works —
# the URL is read back from the agent, not computed — but changes on restart.
#
# This is the ONLY variable for it. `P2P_PUBLIC_DOMAIN` is the old name and is
# still read, but last — it lived here holding the literal placeholder text and
# overrode whatever you set above, which fails the same way a domain reserved on
# someone else's account does. Delete it from your .env if it is still there.
NGROK_DOMAIN=
LOCALTONET_AUTHTOKEN=
