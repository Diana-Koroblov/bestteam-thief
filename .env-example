# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Appendix E rules #39, #40 — leaking any of these fails the project.

# --- Gmail API (Appendix A). Send-only scope. Rule #30. -------------------
GMAIL_CREDENTIALS_PATH=./secrets/credentials.json
GMAIL_TOKEN_PATH=./secrets/token.json

# --- LLM providers. Only the one named in config/<role>/game.toml is used. -
# Diana's machine (no GPU) -> groq. Partner's machine -> ollama.
GROQ_API_KEY=gsk_replace_me
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=sk-ant-replace-me-optional

# --- Tunnelling ------------------------------------------------------------
NGROK_AUTHTOKEN=replace_me
