# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Appendix E rules #39, #40 — leaking any of these fails the project.

# --- Gmail API (Appendix A). Send-only scope. Rule #30. -------------------
GMAIL_CREDENTIALS_PATH=./secrets/credentials.json
GMAIL_TOKEN_PATH=./secrets/token.json

# --- LLM provider ----------------------------------------------------------
# Selects the trash-talk provider for THIS machine. Overrides
# [trash_talk] provider in config/<role>/game.toml, which is committed as
# `template` so a fresh clone always runs with zero tokens.
#   template   book default, zero tokens, no network - safe fallback anywhere
#   ollama     local model, zero API tokens - Itay's machine, graded matches
#   groq       our extra provider - Diana's machine, development only
#   claude_api cloud Haiku, real token cost against the 200k series budget
# Movement is never decided by a model (Ch. 6); this affects text only.
P2P_LLM_PROVIDER=template
GROQ_API_KEY=gsk_replace_me
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=sk-ant-replace-me-optional

# --- Tunnelling ------------------------------------------------------------
NGROK_AUTHTOKEN=replace_me
