# ---------------------------------------------------------------------------
# Secrets — NEVER commit these. Appendix E rules #39, #40.
# A secret leaked once is considered permanently exposed: deleting it in a
# later commit does not help, it stays in the Git history.
# ---------------------------------------------------------------------------
.env
*.env
!.env-example
credentials.json
token.json
*.pem
*.key
client_secret*.json
config/**/secrets.toml

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.venv/
venv/

# ---------------------------------------------------------------------------
# Runtime artefacts (match logs are committed deliberately, not automatically)
# ---------------------------------------------------------------------------
results/tmp/
*.log
!results/**/log_*.json

# Ad-hoc `--out` directories for a live or rehearsal match (results_<name>/,
# outside the committed `results/` tree). A live series writes here while it
# plays; `git add -A` mid-match would stage in-progress artefacts into
# whichever repository is running, real match data included. Committed
# results belong under `results/` on purpose, by hand, once a series ends.
results_*/

# Locally generated series artefacts. They are produced by our own two brains
# playing each other, so they are **not match records** — and a synthetic
# `log_<game_id>_gNN.json` sitting where a grader looks for real ones is exactly
# the plausible-looking placeholder `core/report/artefacts.py` refuses to write.
# Regenerate any time from tests/integration/series_harness.py; the Replay
# Viewer screenshot is taken from these, and they are not evidence of a match.
logs/

# ---------------------------------------------------------------------------
# Generated Obsidian vaults (regenerate with scripts/make_graph_vault.py).
# The screenshot goes in assets/; the vault itself is a build artefact.
# ---------------------------------------------------------------------------
vaults/

# The outgoing negotiation pack (`negotiate --pack outbox/`). Regenerated per
# opponent, and the handshake inside embeds the commit hash of the tree that
# wrote it — a committed copy is stale by construction.
outbox/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db

# Debugging screenshots. They capture whole terminals, which means opponent
# contact addresses and endpoints from the command line - and both role repos
# are public (imreeyal 16/08 window).
docs/evidence/
